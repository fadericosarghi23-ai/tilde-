---
/**
 * Header: navbar visibile. Logo a sinistra, voci a destra (sottolineatura su hover e pagina
 * attiva). transparent = sopra una foto: parte trasparente con testo chiaro e diventa pieno
 * dopo 40px di scroll (script in Layout.astro). Le voci restano sempre visibili (anche su mobile).
 */
import { site } from '../data/site';
import { nav } from '../data/nav';
interface Props { transparent?: boolean }
const { transparent = false } = Astro.props;
const path = Astro.url.pathname;
---
<header class:list={['site-header', transparent ? 'is-transparent' : 'is-solid']} data-transparent={String(transparent)}>
  <div class="container nav-row">
    <div class="nav-head">
      <a class="brand" href="/" aria-label={`${site.nome} — home`}>
        <span class="brand-mark"><strong>tìlde</strong> studio</span>
      </a>
    </div>
    <nav class="main-nav" aria-label="Main">
      {nav.map((v) => (
        <a class="link-underline" href={v.href} aria-current={path === v.href ? 'page' : undefined}>{v.label}</a>
      ))}
    </nav>
  </div>
</header>
