---
/** Sitemap: list of the site pages (useful for users and crawlers). */
import Layout from '../layouts/Layout.astro';
import { nav } from '../data/nav';
import { progettiConDettaglio } from '../data/progetti';
import { site } from '../data/site';

const title = `Sitemap | ${site.nome}`;
const description = 'List of the site pages.';
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Sitemap', href: '/sitemap/' }];
---
<Layout title={title} description={description} crumbs={crumbs}>
  <div class="container section">
    <h1 class="h-title">Sitemap</h1>
    <ul style="margin-top:1.5rem;display:grid;gap:.5rem">
      <li><a class="link-underline" href="/">Home</a></li>
      {nav.map((v) => <li><a class="link-underline" href={v.href}>{v.label}</a></li>)}
    </ul>
    <h2 class="h-title" style="margin-top:2rem">Projects</h2>
    <ul style="margin-top:1rem;display:grid;gap:.5rem">
      {progettiConDettaglio.map((p) => <li><a class="link-underline" href={`/projects/${p.slug}/`}>{p.titolo}</a></li>)}
    </ul>
    <h2 class="h-title" style="margin-top:2rem">Legal</h2>
    <ul style="margin-top:1rem;display:grid;gap:.5rem">
      <li><a class="link-underline" href="/privacy-policy/">Privacy policy</a></li>
      <li><a class="link-underline" href="/cookie-policy/">Cookie policy</a></li>
    </ul>
  </div>
</Layout>
