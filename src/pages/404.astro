---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
---
<Layout title={`Page not found | ${site.nome}`} description="The page you are looking for doesn't exist or has been moved." noindex>
<section class="page-head bg-sand" style="min-height: 70svh"> <div class="container narrow"> <p class="eyebrow mb-2">Error 404</p> <h1 class="h1-page">This page doesn't exist</h1> <p class="lead mt-3">The page you are looking for has been moved or never existed. You can start again from the home page or the projects.</p> <div class="btn-row mt-4"> <a href="/" class="btn btn-primary">Go to home</a> <a href="/projects/" class="btn btn-outline">Projects</a> <a href="/contact/" class="btn btn-outline">Contact</a> </div> </div> </section>
</Layout>
