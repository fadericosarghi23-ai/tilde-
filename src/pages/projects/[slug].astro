---
/**
 * Project detail: title + data + description, then TWO always-open columns — Photos (left) and
 * Drawings (right), as requested. If a project has no drawings, Photos span a single centered
 * column. Click any image for the lightbox.
 */
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import { progettiConDettaglio } from '../../data/progetti';
import { fullSrc } from '../../lib/media';
import { site } from '../../data/site';

export function getStaticPaths() {
  return progettiConDettaglio.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
const title = `${p.titolo} | ${site.nome}`;
const description = p.descrizione;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Projects', href: '/projects/' },
  { name: p.titolo, href: `/projects/${p.slug}/` },
];
const foto = p.foto ?? [];
const disegni = p.disegni ?? [];
const twoCol = disegni.length > 0;
---
<Layout title={title} description={description} pageType="ItemPage" ogType="article" crumbs={crumbs}>
  <article class="container project-wrap">
    <div class="project-layout">
      <header class="project-head reveal">
        <h1>{p.titolo}</h1>
        <p class="place-year">{p.luogo} · {p.anno}{p.nota ? ` · ${p.nota}` : ''}</p>
        <div class="project-meta">
          <span><b>Client:</b> {p.cliente}</span>
          <span><b>Use:</b> {p.destinazione}</span>
          <span><b>Works:</b> {p.intervento}</span>
          <span><b>Status:</b> {p.stato}</span>
          <span><b>Team:</b> {p.team}</span>
        </div>
        <p class="project-desc">{p.descrizione}</p>
        <a class="project-back" href="/projects/">← Back to projects</a>
      </header>

      <div class:list={['project-cols', !twoCol && 'single']}>
        <section class="project-col reveal">
          <h2 class="pcol-h">Photos</h2>
          <div class="pcol-imgs">
            {foto.map((img) => (
              <figure>
                <button type="button" data-full={fullSrc(img)} data-alt={img.alt} aria-label="Enlarge image"><Picture img={img} sizes="(min-width:900px) 40vw, 100vw" /></button>
              </figure>
            ))}
          </div>
        </section>

        {twoCol && (
          <section class="project-col reveal">
            <h2 class="pcol-h">Drawings</h2>
            <div class="pcol-imgs pcol-drawings">
              {disegni.map((img) => (
                <figure>
                  <button type="button" data-full={fullSrc(img)} data-alt={img.alt} aria-label="Enlarge drawing"><Picture img={img} sizes="(min-width:900px) 40vw, 100vw" /></button>
                </figure>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </article>

  <div class="lightbox" data-lb aria-hidden="true">
    <button type="button" class="close" data-lb-close aria-label="Close">×</button>
    <img data-lb-img alt="">
  </div>
</Layout>

<style is:global>
  .project-wrap { max-width: none; padding-top: calc(var(--header-h) + 1.5rem); padding-bottom: 4rem; padding-inline: clamp(1.5rem, 4vw, 4.5rem); }
  .project-layout { display: grid; gap: 2rem; }
  @media (min-width: 900px) { .project-layout { grid-template-columns: 300px 1fr; gap: 4rem; align-items: start; } .project-head { position: sticky; top: calc(var(--header-h) + 1.5rem); text-align: left; } }
  .project-head h1 { font-size: clamp(1.8rem, 2.6vw, 2.6rem); margin: 0 0 .3rem; }
  .place-year { color: #6b6b6b; margin: 0 0 1.25rem; }
  .project-meta { display: grid; gap: .3rem; font-size: .9rem; margin: 0 0 1.4rem; color: #333; }
  .project-meta b { font-weight: 600; }
  .project-desc { line-height: 1.65; color: #333; margin: 0 0 1.5rem; font-size: .95rem; }
  .project-back { font-size: .85rem; color: #6b6b6b; text-decoration: none; }
  .project-back:hover { color: var(--ink, #0a0a0a); text-decoration: underline; text-underline-offset: 3px; }

  .project-cols { display: grid; gap: 2rem; }
  @media (min-width: 900px) {
    .project-cols { grid-template-columns: 1fr 1fr; gap: 3rem; align-items: start; }
    /* Ogni colonna scorre in modo indipendente (non insieme) */
    .project-cols:not(.single) .pcol-imgs { max-height: calc(100svh - var(--header-h) - 5rem); overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: transparent transparent; }
    .project-cols:not(.single) .pcol-imgs:hover { scrollbar-color: rgba(10,10,10,.18) transparent; }
    /* Scrollbar sul bordo esterno: a sinistra nella colonna sinistra, a destra nella destra */
    .project-cols:not(.single) .project-col:first-child .pcol-imgs { direction: rtl; }
    .project-cols:not(.single) .project-col:first-child .pcol-imgs > figure { direction: ltr; }
  }
  /* Scrollbar minimal (WebKit): quasi invisibile, appena un filo al passaggio del mouse */
  .pcol-imgs::-webkit-scrollbar { width: 3px; }
  .pcol-imgs::-webkit-scrollbar-thumb { background: transparent; border-radius: 3px; }
  .pcol-imgs:hover::-webkit-scrollbar-thumb { background: rgba(10,10,10,.18); }
  .pcol-imgs::-webkit-scrollbar-track { background: transparent; }
  .project-cols.single { max-width: 60rem; margin: 0 auto; grid-template-columns: 1fr; }
  .pcol-h { font-size: .78rem; text-transform: uppercase; letter-spacing: .1em; color: #8a8a8a; padding: 0 0 .6rem; margin: 0 0 1rem; border-bottom: 1px solid rgba(10,10,10,.12); }
  .pcol-imgs figure { margin: 0 0 1rem; }
  .pcol-imgs button { display: block; width: 100%; padding: 0; border: 0; background: #f2f2f2; cursor: zoom-in; }
  .pcol-imgs img { width: 100%; height: auto; display: block; }
  .pcol-drawings button { background: #fff; }

  .lightbox { position: fixed; inset: 0; z-index: 2000; background: #0a0a0aef; display: none; align-items: center; justify-content: center; padding: 3vmin; }
  .lightbox.is-open { display: flex; }
  .lightbox img { max-width: 94vw; max-height: 90vh; width: auto; height: auto; object-fit: contain; }
  .lightbox .close { position: fixed; top: 1rem; right: 1.4rem; background: none; border: 0; color: #fff; font-size: 2.4rem; line-height: 1; cursor: pointer; }
</style>

<script>
  // Lightbox della galleria: apre l'immagine a schermo intero, frecce + Esc.
  const lb = document.querySelector('[data-lb]');
  const lbImg = lb?.querySelector('[data-lb-img]');
  const items = [...document.querySelectorAll('[data-full]')];
  let idx = 0;
  const open = (i) => {
    if (!lb || !lbImg) return;
    idx = (i + items.length) % items.length;
    lbImg.src = items[idx].dataset.full || '';
    lbImg.alt = items[idx].dataset.alt || '';
    lb.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  };
  const close = () => { lb?.classList.remove('is-open'); document.body.style.overflow = ''; };
  items.forEach((b, i) => b.addEventListener('click', (e) => { e.preventDefault(); open(i); }));
  lb?.addEventListener('click', (e) => {
    const t = e.target;
    if (t === lb || t.hasAttribute('data-lb-close')) close();
  });
  document.addEventListener('keydown', (e) => {
    if (!lb?.classList.contains('is-open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') open(idx + 1);
    if (e.key === 'ArrowLeft') open(idx - 1);
  });

  // Scroll delle colonne: porta il logo nell'angolo (le colonne scorrono, non la finestra).
  const cols = [...document.querySelectorAll('.pcol-imgs')];
  const onColScroll = () => {
    const scrolled = window.scrollY > 40 || cols.some((c) => c.scrollTop > 40);
    document.body.classList.toggle('scrolled', scrolled);
  };
  cols.forEach((c) => c.addEventListener('scroll', onColScroll, { passive: true }));
</script>
